{
  "title": "CloudSentinel operations",
  "uid": "cloudsentinel",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Ingestion rate",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(cloudsentinel_events_total[5m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Alert rate",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(cloudsentinel_alerts_total[5m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Ingest p95 latency",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(cloudsentinel_ingest_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    }
  ]
}